# NutriClinic Pro Enterprise — Environment variables
# Copy this file to `.env` and adjust values.
# NEVER commit `.env` — use Vercel / Supabase dashboards for production secrets.

# App metadata
VITE_APP_NAME="NutriClinic Pro Enterprise"

# Laravel 12 REST API (future — when backend exists)
VITE_API_URL=http://localhost:8000/api/v1

# Supabase (create a NEW project — do not reuse ActNow / aceactnow)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here
